{
 "template": "sweptarea",
 "template_version": "2.1.0",
 "stox_version": "4.2.1",
 "description": "StoX swept-area chain. Abundance from length distributions (optionally regrouped); biomass either from catch weight (total_catch) or through super-individuals (super_individuals, as in many StoX projects); one PSU per station; bootstrap of the mean length distribution; species and station filters. Structure only (class C3); filled from a survey configuration by the package, never edited by hand.",
 "processes": [
  {
   "model": "baseline",
   "name": "ReadBiotic",
   "function": "RstoxData::ReadBiotic",
   "parameters": {
    "FileNames": "{{biotic_files}}"
   }
  },
  {
   "model": "baseline",
   "name": "StoxBiotic",
   "function": "RstoxData::StoxBiotic",
   "inputs": {
    "BioticData": "ReadBiotic"
   }
  },
  {
   "model": "baseline",
   "name": "Translation",
   "function": "RstoxData::DefineTranslation",
   "parameters": {
    "DefinitionMethod": "Table",
    "VariableName": "EffectiveTowDistance",
    "Conditional": true,
    "ConditionalVariableNames": "HaulKey",
    "TranslationTable": "{{translation_table}}"
   },
   "when": "distance_translation"
  },
  {
   "model": "baseline",
   "name": "TranslateStoxBiotic",
   "function": "RstoxData::TranslateStoxBiotic",
   "inputs": {
    "StoxBioticData": "StoxBiotic",
    "Translation": "Translation"
   },
   "parameters": {
    "TranslationDefinition": "FunctionInput"
   },
   "when": "distance_translation"
  },
  {
   "model": "baseline",
   "name": "FilterStoxBiotic",
   "function": "RstoxData::FilterStoxBiotic",
   "inputs": {
    "StoxBioticData": "{{stoxbiotic_process}}"
   },
   "parameters": {
    "FilterExpression": "{{filter_expression}}",
    "FilterUpwards": true
   }
  },
  {
   "model": "baseline",
   "name": "SpeciesFilter",
   "function": "RstoxData::FilterStoxBiotic",
   "inputs": {
    "StoxBioticData": "FilterStoxBiotic"
   },
   "parameters": {
    "FilterExpression": "{{species_filter_expression}}",
    "FilterUpwards": false
   }
  },
  {
   "model": "baseline",
   "name": "StratumPolygon",
   "function": "RstoxBase::DefineStratumPolygon",
   "parameters": {
    "DefinitionMethod": "ResourceFile",
    "FileName": "{{strata_file}}",
    "StratumNameLabel": "{{stratum_label}}"
   }
  },
  {
   "model": "baseline",
   "name": "Survey",
   "function": "RstoxBase::DefineSurvey",
   "inputs": {
    "StratumPolygon": "StratumPolygon"
   },
   "parameters": {
    "DefinitionMethod": "{{survey_method}}",
    "SurveyTable": "{{survey_table}}"
   }
  },
  {
   "model": "baseline",
   "name": "BioticPSU",
   "function": "RstoxBase::DefineBioticPSU",
   "inputs": {
    "StratumPolygon": "StratumPolygon",
    "StoxBioticData": "FilterStoxBiotic"
   },
   "parameters": {
    "DefinitionMethod": "StationToPSU"
   }
  },
  {
   "model": "baseline",
   "name": "BioticLayer",
   "function": "RstoxBase::DefineBioticLayer",
   "inputs": {
    "StoxBioticData": "FilterStoxBiotic"
   },
   "parameters": {
    "DefinitionMethod": "WaterColumn"
   }
  },
  {
   "model": "baseline",
   "name": "LengthDistribution",
   "function": "RstoxBase::LengthDistribution",
   "inputs": {
    "StoxBioticData": "SpeciesFilter"
   },
   "parameters": {
    "LengthDistributionType": "Normalized",
    "RaisingFactorPriority": "{{raising_factor_priority}}"
   },
   "when": "abundance_branch"
  },
  {
   "model": "baseline",
   "name": "Regroup",
   "function": "RstoxBase::RegroupLengthDistribution",
   "inputs": {
    "LengthDistributionData": "LengthDistribution"
   },
   "parameters": {
    "LengthInterval": "{{length_interval}}"
   },
   "when": "regroup"
  },
  {
   "model": "baseline",
   "name": "SumLengthDistribution",
   "function": "RstoxBase::SumLengthDistribution",
   "inputs": {
    "LengthDistributionData": "{{length_process}}",
    "BioticLayer": "BioticLayer"
   },
   "parameters": {
    "LayerDefinition": "FunctionInput"
   },
   "when": "abundance_branch"
  },
  {
   "model": "baseline",
   "name": "MeanLengthDistribution",
   "function": "RstoxBase::MeanLengthDistribution",
   "inputs": {
    "SumLengthDistributionData": "SumLengthDistribution",
    "BioticLayer": "BioticLayer",
    "Survey": "Survey",
    "BioticPSU": "BioticPSU"
   },
   "parameters": {
    "LayerDefinition": "PreDefined",
    "SurveyDefinition": "FunctionInput",
    "PSUDefinition": "FunctionInput"
   },
   "when": "abundance_branch"
  },
  {
   "model": "baseline",
   "name": "AbundanceDensity",
   "function": "RstoxBase::SweptAreaDensity",
   "inputs": {
    "MeanLengthDistributionData": "MeanLengthDistribution"
   },
   "parameters": {
    "SweptAreaDensityMethod": "LengthDistributed",
    "SweepWidthMethod": "Constant",
    "SweepWidth": "{{sweep_width_m}}",
    "DensityType": "AreaNumberDensity"
   },
   "when": "abundance_branch"
  },
  {
   "model": "baseline",
   "name": "MeanAbundanceDensity",
   "function": "RstoxBase::MeanDensity",
   "inputs": {
    "DensityData": "AbundanceDensity"
   },
   "when": "abundance_branch"
  },
  {
   "model": "baseline",
   "name": "SpeciesCategoryCatch",
   "function": "RstoxBase::SpeciesCategoryCatch",
   "inputs": {
    "StoxBioticData": "SpeciesFilter"
   },
   "parameters": {
    "SpeciesCategoryCatchType": "Normalized"
   },
   "when": "catch_biomass"
  },
  {
   "model": "baseline",
   "name": "SumSpeciesCategoryCatch",
   "function": "RstoxBase::SumSpeciesCategoryCatch",
   "inputs": {
    "SpeciesCategoryCatchData": "SpeciesCategoryCatch",
    "BioticLayer": "BioticLayer"
   },
   "parameters": {
    "LayerDefinition": "FunctionInput"
   },
   "when": "catch_biomass"
  },
  {
   "model": "baseline",
   "name": "MeanSpeciesCategoryCatch",
   "function": "RstoxBase::MeanSpeciesCategoryCatch",
   "inputs": {
    "SumSpeciesCategoryCatchData": "SumSpeciesCategoryCatch",
    "BioticLayer": "BioticLayer",
    "Survey": "Survey",
    "BioticPSU": "BioticPSU"
   },
   "parameters": {
    "LayerDefinition": "PreDefined",
    "SurveyDefinition": "FunctionInput",
    "PSUDefinition": "FunctionInput"
   },
   "when": "catch_biomass"
  },
  {
   "model": "baseline",
   "name": "BiomassDensity",
   "function": "RstoxBase::SweptAreaDensity",
   "inputs": {
    "MeanSpeciesCategoryCatchData": "MeanSpeciesCategoryCatch"
   },
   "parameters": {
    "SweptAreaDensityMethod": "TotalCatch",
    "SweepWidthMethod": "Constant",
    "SweepWidth": "{{sweep_width_m}}",
    "DensityType": "AreaWeightDensity"
   },
   "when": "catch_biomass"
  },
  {
   "model": "baseline",
   "name": "MeanBiomassDensity",
   "function": "RstoxBase::MeanDensity",
   "inputs": {
    "DensityData": "BiomassDensity"
   },
   "when": "catch_biomass"
  },
  {
   "model": "baseline",
   "name": "StratumArea",
   "function": "RstoxBase::StratumArea",
   "inputs": {
    "StratumPolygon": "StratumPolygon"
   },
   "parameters": {
    "AreaMethod": "Accurate"
   }
  },
  {
   "model": "baseline",
   "name": "Abundance",
   "function": "RstoxBase::Quantity",
   "inputs": {
    "MeanDensityData": "MeanAbundanceDensity",
    "StratumAreaData": "StratumArea"
   },
   "when": "abundance_branch"
  },
  {
   "model": "baseline",
   "name": "Biomass",
   "function": "RstoxBase::Quantity",
   "inputs": {
    "MeanDensityData": "MeanBiomassDensity",
    "StratumAreaData": "StratumArea"
   },
   "when": "catch_biomass"
  },
  {
   "model": "baseline",
   "name": "Individuals",
   "function": "RstoxBase::Individuals",
   "inputs": {
    "StoxBioticData": "SpeciesFilter",
    "MeanLengthDistributionData": "MeanLengthDistribution"
   },
   "parameters": {
    "QuantityType": "SweptArea"
   },
   "when": "route_si"
  },
  {
   "model": "baseline",
   "name": "SuperIndividuals",
   "function": "RstoxBase::SuperIndividuals",
   "inputs": {
    "IndividualsData": "Individuals",
    "QuantityData": "Abundance",
    "LengthDistributionData": "{{length_process}}"
   },
   "parameters": {
    "DistributionMethod": "{{si_distribution_method}}"
   },
   "when": "route_si"
  },
  {
   "model": "baseline",
   "name": "ImputeSuperIndividuals",
   "function": "RstoxBase::ImputeSuperIndividuals",
   "inputs": {
    "SuperIndividualsData": "SuperIndividuals"
   },
   "parameters": {
    "ImputationMethod": "{{impute_method}}",
    "ImputeAtMissing": "{{impute_at_missing}}",
    "ToImpute": "{{impute_to}}",
    "ImputeByEqual": "{{impute_by_equal}}",
    "ImputationLevels": "{{impute_levels}}",
    "Seed": "{{impute_seed}}"
   },
   "when": "route_si"
  },
  {
   "model": "analysis",
   "name": "Bootstrap",
   "function": "RstoxFramework::Bootstrap",
   "parameters": {
    "BootstrapMethodTable": "{{bootstrap_method_table}}",
    "NumberOfBootstraps": "{{replicates}}",
    "OutputProcesses": "{{output_processes}}",
    "NumberOfCores": "{{cores}}"
   },
   "when": "route_catch"
  },
  {
   "model": "analysis",
   "name": "Bootstrap",
   "function": "RstoxFramework::Bootstrap",
   "parameters": {
    "BootstrapMethodTable": "{{bootstrap_method_table}}",
    "NumberOfBootstraps": "{{replicates}}",
    "OutputProcesses": "{{output_processes}}",
    "BaselineSeedTable": "{{baseline_seed_table}}",
    "NumberOfCores": "{{cores}}"
   },
   "when": "route_si"
  },
  {
   "model": "report",
   "name": "ReportBiomassByStratum",
   "function": "RstoxBase::ReportQuantity",
   "inputs": {
    "QuantityData": "Biomass"
   },
   "parameters": {
    "TargetVariable": "Biomass",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Stratum",
     "SpeciesCategory"
    ]
   },
   "when": "catch_biomass"
  },
  {
   "model": "report",
   "name": "ReportBootstrapBiomassByStratum",
   "function": "RstoxFramework::ReportBootstrap",
   "inputs": {
    "BootstrapData": "Bootstrap"
   },
   "parameters": {
    "BaselineProcess": "Biomass",
    "TargetVariable": "Biomass",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Stratum",
     "SpeciesCategory"
    ],
    "BootstrapReportFunction": "summaryStox",
    "Percentages": [
     2.5,
     97.5
    ]
   },
   "when": "catch_biomass"
  },
  {
   "model": "report",
   "name": "ReportBiomassTotal",
   "function": "RstoxBase::ReportQuantity",
   "inputs": {
    "QuantityData": "Biomass"
   },
   "parameters": {
    "TargetVariable": "Biomass",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Survey",
     "SpeciesCategory"
    ]
   },
   "when": "catch_biomass"
  },
  {
   "model": "report",
   "name": "ReportBootstrapBiomassTotal",
   "function": "RstoxFramework::ReportBootstrap",
   "inputs": {
    "BootstrapData": "Bootstrap"
   },
   "parameters": {
    "BaselineProcess": "Biomass",
    "TargetVariable": "Biomass",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Survey",
     "SpeciesCategory"
    ],
    "BootstrapReportFunction": "summaryStox",
    "Percentages": [
     2.5,
     97.5
    ]
   },
   "when": "catch_biomass"
  },
  {
   "model": "report",
   "name": "ReportBiomassByStratum",
   "function": "RstoxBase::ReportSuperIndividuals",
   "inputs": {
    "SuperIndividualsData": "ImputeSuperIndividuals"
   },
   "parameters": {
    "TargetVariable": "Biomass",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Stratum",
     "SpeciesCategory"
    ],
    "RemoveMissingValues": true
   },
   "when": "si_biomass"
  },
  {
   "model": "report",
   "name": "ReportBootstrapBiomassByStratum",
   "function": "RstoxFramework::ReportBootstrap",
   "inputs": {
    "BootstrapData": "Bootstrap"
   },
   "parameters": {
    "BaselineProcess": "ImputeSuperIndividuals",
    "TargetVariable": "Biomass",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Stratum",
     "SpeciesCategory"
    ],
    "BootstrapReportFunction": "summaryStox",
    "Percentages": [
     2.5,
     97.5
    ],
    "RemoveMissingValues": true
   },
   "when": "si_biomass"
  },
  {
   "model": "report",
   "name": "ReportBiomassTotal",
   "function": "RstoxBase::ReportSuperIndividuals",
   "inputs": {
    "SuperIndividualsData": "ImputeSuperIndividuals"
   },
   "parameters": {
    "TargetVariable": "Biomass",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Survey",
     "SpeciesCategory"
    ],
    "RemoveMissingValues": true
   },
   "when": "si_biomass"
  },
  {
   "model": "report",
   "name": "ReportBootstrapBiomassTotal",
   "function": "RstoxFramework::ReportBootstrap",
   "inputs": {
    "BootstrapData": "Bootstrap"
   },
   "parameters": {
    "BaselineProcess": "ImputeSuperIndividuals",
    "TargetVariable": "Biomass",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Survey",
     "SpeciesCategory"
    ],
    "BootstrapReportFunction": "summaryStox",
    "Percentages": [
     2.5,
     97.5
    ],
    "RemoveMissingValues": true
   },
   "when": "si_biomass"
  },
  {
   "model": "report",
   "name": "ReportAbundanceByStratum",
   "function": "RstoxBase::ReportQuantity",
   "inputs": {
    "QuantityData": "Abundance"
   },
   "parameters": {
    "TargetVariable": "Abundance",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Stratum",
     "SpeciesCategory"
    ]
   },
   "when": "catch_abundance"
  },
  {
   "model": "report",
   "name": "ReportBootstrapAbundanceByStratum",
   "function": "RstoxFramework::ReportBootstrap",
   "inputs": {
    "BootstrapData": "Bootstrap"
   },
   "parameters": {
    "BaselineProcess": "Abundance",
    "TargetVariable": "Abundance",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Stratum",
     "SpeciesCategory"
    ],
    "BootstrapReportFunction": "summaryStox",
    "Percentages": [
     2.5,
     97.5
    ]
   },
   "when": "catch_abundance"
  },
  {
   "model": "report",
   "name": "ReportAbundanceTotal",
   "function": "RstoxBase::ReportQuantity",
   "inputs": {
    "QuantityData": "Abundance"
   },
   "parameters": {
    "TargetVariable": "Abundance",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Survey",
     "SpeciesCategory"
    ]
   },
   "when": "catch_abundance"
  },
  {
   "model": "report",
   "name": "ReportBootstrapAbundanceTotal",
   "function": "RstoxFramework::ReportBootstrap",
   "inputs": {
    "BootstrapData": "Bootstrap"
   },
   "parameters": {
    "BaselineProcess": "Abundance",
    "TargetVariable": "Abundance",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Survey",
     "SpeciesCategory"
    ],
    "BootstrapReportFunction": "summaryStox",
    "Percentages": [
     2.5,
     97.5
    ]
   },
   "when": "catch_abundance"
  },
  {
   "model": "report",
   "name": "ReportAbundanceByStratum",
   "function": "RstoxBase::ReportSuperIndividuals",
   "inputs": {
    "SuperIndividualsData": "ImputeSuperIndividuals"
   },
   "parameters": {
    "TargetVariable": "Abundance",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Stratum",
     "SpeciesCategory"
    ],
    "RemoveMissingValues": true
   },
   "when": "si_abundance"
  },
  {
   "model": "report",
   "name": "ReportBootstrapAbundanceByStratum",
   "function": "RstoxFramework::ReportBootstrap",
   "inputs": {
    "BootstrapData": "Bootstrap"
   },
   "parameters": {
    "BaselineProcess": "ImputeSuperIndividuals",
    "TargetVariable": "Abundance",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Stratum",
     "SpeciesCategory"
    ],
    "BootstrapReportFunction": "summaryStox",
    "Percentages": [
     2.5,
     97.5
    ],
    "RemoveMissingValues": true
   },
   "when": "si_abundance"
  },
  {
   "model": "report",
   "name": "ReportAbundanceTotal",
   "function": "RstoxBase::ReportSuperIndividuals",
   "inputs": {
    "SuperIndividualsData": "ImputeSuperIndividuals"
   },
   "parameters": {
    "TargetVariable": "Abundance",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Survey",
     "SpeciesCategory"
    ],
    "RemoveMissingValues": true
   },
   "when": "si_abundance"
  },
  {
   "model": "report",
   "name": "ReportBootstrapAbundanceTotal",
   "function": "RstoxFramework::ReportBootstrap",
   "inputs": {
    "BootstrapData": "Bootstrap"
   },
   "parameters": {
    "BaselineProcess": "ImputeSuperIndividuals",
    "TargetVariable": "Abundance",
    "ReportFunction": "sum",
    "GroupingVariables": [
     "Survey",
     "SpeciesCategory"
    ],
    "BootstrapReportFunction": "summaryStox",
    "Percentages": [
     2.5,
     97.5
    ],
    "RemoveMissingValues": true
   },
   "when": "si_abundance"
  }
 ]
}